{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-I",
        "-c",
        "import functools,os,socketserver,http.server; port=int(os.environ.get('PORT','8723')); h=functools.partial(http.server.SimpleHTTPRequestHandler, directory='/private/tmp/cryptotimelock-preview'); socketserver.ThreadingTCPServer.allow_reuse_address=True; socketserver.ThreadingTCPServer(('127.0.0.1',port), h).serve_forever()"
      ],
      "port": 8723,
      "autoPort": true
    }
  ]
}